{
  "source": "Kryz Brand Guidelines v2 (20 November 2026), brand/source/Kryz-Brand-Guidelines.md",
  "colors": {
    "kryzBlack": "#141012",
    "plumSurface": "#1E181B",
    "neonPink": "#FF3D9A",
    "brightYellow": "#FFD23F",
    "softWhite": "#F3E9EC",
    "warmWhite": "#FFF9F7",
    "roseGray": "#BDAEB4",
    "darkGoldLogoOnly": "#B8860B",
    "pinkDeepTextOnLight": "#B0115A"
  },
  "fonts": {
    "headline": { "family": "Manrope", "weight": 800, "file": "fonts/Manrope-ExtraBold.ttf" },
    "accent": { "family": "Instrument Serif", "style": "italic", "file": "fonts/InstrumentSerif-Italic.ttf" },
    "body": { "family": "Inter", "weight": 400, "file": "fonts/Inter-Regular.ttf" },
    "bodyStrong": { "family": "Inter", "weight": 600, "file": "fonts/Inter-SemiBold.ttf" }
  },
  "captions": {
    "font": "Manrope",
    "fill": "#F3E9EC",
    "highlight": "#FFD23F",
    "outline": "#141012",
    "outlinePx": 6,
    "shadowPx": 0,
    "maxWordsPerScreen": 4,
    "maxCharsPerLine": 18,
    "sizePxAt1080Wide": 78,
    "verticalCenterFromTop": 0.62
  },
  "logo": {
    "markOnDark": "../brand/logo/kryz-mark-3d.svg",
    "markPngOnDark": "../brand/source/kryz-mark-3d.png",
    "markPngFlat": "../brand/source/kryz-mark.png",
    "fullOnDark": "../brand/logo/kryz-logo-3d-glow-for-dark.png",
    "fullOnLight": "../brand/logo/kryz-logo-3d-for-light.png",
    "watermarkHeightPx": 72,
    "watermarkOpacity": 0.85,
    "minMarkHeightPx": 24,
    "minFullLogoWidthPx": 140
  },
  "radiusPx": 22,
  "glow": "0 0 48px rgba(255,61,154,0.55)"
}
